---
// Clean Blog Link Section
const blogUrl = "https://blogs.mayankkumargupta.com";
---

<section id="blog" class="py-8">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="border border-[#1a3826] hover:border-[#00ff66] bg-[#0a110d] p-6 sm:p-8 rounded transition-colors box-glow">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        
        <div class="space-y-2 max-w-2xl">
          <div class="text-xs font-mono text-[#00ff66] font-semibold flex items-center gap-2">
            <span>// TECHNICAL WRITING</span>
            <span class="text-zinc-500">•</span>
            <span class="text-zinc-400">blogs.mayankkumargupta.com</span>
          </div>

          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight">
            Notes on Systems, AI Agents & Backend Architecture
          </h2>

          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
            I write deep technical write-ups covering LangGraph workflows, Graph RAG, 
            FastAPI and Django performance optimizations, and Linux systems engineering.
          </p>
        </div>

        <div>
          <a 
            href={blogUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="matrix-btn inline-flex items-center gap-2 bg-[#00ff66] text-[#050807] font-bold text-xs px-5 py-3 rounded tracking-wider whitespace-nowrap"
          >
            <span>Visit Blog</span>
            <span class="text-sm">↗</span>
          </a>
        </div>

      </div>
    </div>

  </div>
</section>
