---
// Clean, minimal Contact section
const email = "mayankcryptobyte@gmail.com";
const phone = "+91 9875609901";
const blogUrl = "https://blogs.mayankkumargupta.com";
---

<section id="contact" class="py-12 border-t border-[#1a3826]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="mb-8">
      <div class="text-xs font-mono text-[#00ff66] uppercase font-semibold mb-1">
        // Transmission
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Contact & Connect
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
      
      <!-- Left: Direct Reach -->
      <div class="md:col-span-6 border border-[#1a3826] bg-[#0a110d] p-6 rounded space-y-4">
        <h3 class="text-xs font-mono font-bold text-[#00ff66] uppercase tracking-wider">
          Direct Channels
        </h3>
        
        <div class="space-y-3 text-xs font-mono">
          <div>
            <span class="text-zinc-400 block text-[11px]">EMAIL:</span>
            <a href={`mailto:${email}`} class="text-white hover:text-[#00ff66] font-semibold transition-colors">
              {email}
            </a>
          </div>

          <div>
            <span class="text-zinc-400 block text-[11px]">PHONE:</span>
            <span class="text-zinc-300">{phone}</span>
          </div>

          <div>
            <span class="text-zinc-400 block text-[11px]">LOCATION:</span>
            <span class="text-zinc-300">Kolkata, West Bengal, India</span>
          </div>
        </div>

        <div class="pt-2">
          <a 
            href={`mailto:${email}`} 
            class="matrix-btn inline-block bg-[#00ff66] text-[#050807] font-bold text-xs px-4 py-2 rounded"
          >
            Send Email ↗
          </a>
        </div>
      </div>

      <!-- Right: Profiles & Links -->
      <div class="md:col-span-6 border border-[#1a3826] bg-[#0a110d] p-6 rounded space-y-4">
        <h3 class="text-xs font-mono font-bold text-[#00ff66] uppercase tracking-wider">
          Profiles & Writing
        </h3>

        <ul class="space-y-2.5 text-xs font-mono">
          <li>
            <a 
              href={blogUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-between text-zinc-300 hover:text-[#00ff66] py-1 transition-colors border-b border-[#14261b]"
            >
              <span>Technical Blog</span>
              <span class="text-[#00ff66]">blogs.mayankkumargupta.com ↗</span>
            </a>
          </li>

          <li>
            <a 
              href="https://github.com/mayankkumargupta1" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-between text-zinc-300 hover:text-[#00ff66] py-1 transition-colors border-b border-[#14261b]"
            >
              <span>GitHub</span>
              <span class="text-zinc-400">@mayankkumargupta1 ↗</span>
            </a>
          </li>

          <li>
            <a 
              href="https://linkedin.com/in/mayankkumargupta1" 
              target="_blank" 
              rel="noopener noreferrer" 
              class="flex items-center justify-between text-zinc-300 hover:text-[#00ff66] py-1 transition-colors border-b border-[#14261b]"
            >
              <span>LinkedIn</span>
              <span class="text-zinc-400">in/mayankkumargupta1 ↗</span>
            </a>
          </li>
        </ul>
      </div>

    </div>

  </div>
</section>
