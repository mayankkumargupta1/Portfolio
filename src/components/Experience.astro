---
// Accurate experience timeline from Resume

interface ExperienceItem {
  company: string;
  role: string;
  location: string;
  period: string;
  url: string;
  description: string;
}

const experiences: ExperienceItem[] = [
  {
    company: "Lovely Professional University (LPU)",
    role: "Backend/AI Intern at Infotech",
    location: "Jalandhar, Punjab",
    period: "Aug 2025 — Jul 2026",
    url: "https://www.lpu.in/",
    description: "Worked on building an Agentic AI assistant for students, integrating university policies with real-time student services. Developed a system capable of answering policy-bound queries and securely performing student actions."
  },
  {
    company: "GradGlobe Pvt. Ltd.",
    role: "Backend/AI Developer (Freelance)",
    location: "Jalandhar, Punjab",
    period: "Jun 2025 — Present",
    url: "https://www.gradglobe.org/",
    description: "Built an AI-driven university enrichment platform with an integrated CRM and test dashboard. The agent auto-researches draft entries, scrapes the web for rankings, costs, visas, and location data, and generates structured updates for the Django Backend."
  },
  {
    company: "Sanch Foundation (NGO)",
    role: "Web Developer (Intern)",
    location: "Remote",
    period: "Jul 2024 — Aug 2024",
    url: "https://sanchfoundation.org/",
    description: "Created a Certificate Management System for the foundation (certificates.sanchfoundation.org) with image gallery generation."
  },
  {
    company: "Promist Solutions",
    role: "Web Developer (Intern)",
    location: "Remote",
    period: "Jul 2024 — Aug 2024",
    url: "https://promistsolutions.com/",
    description: "Worked on the Emerging India platform (full Django-based project). Built core features, integrated online payments, and developed a custom CRM to manage leads and operations, improving workflows and overall system performance."
  },
  {
    company: "Instloo Pvt. Ltd.",
    role: "Web Developer (Intern)",
    location: "Remote",
    period: "Dec 2023 — Mar 2024",
    url: "https://instloo.com/",
    description: "Built and deployed full-stack Django apps, including an AI background remover and a gold-price tracker across Python, JavaScript, and web tooling."
  }
];
---

<section id="experience" class="py-12 border-t border-[#1a3826]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="mb-8">
      <div class="text-xs font-mono text-[#00ff66] uppercase font-semibold mb-1">
        // Career Path
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Work Experience
      </h2>
    </div>

    <div class="space-y-4">
      {experiences.map((item) => (
        <div class="border border-[#1a3826] hover:border-[#00ff66] bg-[#0a110d] p-5 sm:p-6 rounded transition-colors">
          
          <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-1 border-b border-[#14261b] pb-3 mb-3">
            <div>
              <a 
                href={item.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="text-base sm:text-lg font-bold text-white hover:text-[#00ff66] transition-colors inline-flex items-center gap-1.5"
              >
                <span>{item.company}</span>
                <span class="text-xs text-[#00ff66]">↗</span>
              </a>
              <div class="text-xs sm:text-sm font-semibold text-[#00ff66] mt-0.5">
                {item.role}
              </div>
            </div>

            <div class="text-xs font-mono text-zinc-400">
              <span>{item.period}</span>
              <span class="mx-1.5">•</span>
              <span>{item.location}</span>
            </div>
          </div>

          <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
            {item.description}
          </p>

        </div>
      ))}
    </div>

  </div>
</section>
