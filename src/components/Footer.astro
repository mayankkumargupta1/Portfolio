---
// Clean, minimal footer
const currentYear = new Date().getFullYear();
const blogUrl = "https://blogs.mayankkumargupta.com";
---

<footer class="border-t border-[#1a3826] bg-[#050807] py-8 text-xs font-mono text-zinc-400">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
      
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-[#00ff66]"></span>
        <span>© {currentYear} Mayank Kumar Gupta</span>
        <span class="text-zinc-600">•</span>
        <span class="text-zinc-400">Kolkata, India</span>
      </div>

      <div class="flex items-center gap-4">
        <a href={blogUrl} target="_blank" rel="noopener noreferrer" class="hover:text-[#00ff66] transition-colors">
          Blog ↗
        </a>
        <a href="https://github.com/mayankkumargupta1" target="_blank" rel="noopener noreferrer" class="hover:text-[#00ff66] transition-colors">
          GitHub
        </a>
        <a href="https://linkedin.com/in/mayankkumargupta1" target="_blank" rel="noopener noreferrer" class="hover:text-[#00ff66] transition-colors">
          LinkedIn
        </a>
        <a href="#about" class="text-zinc-400 hover:text-[#00ff66] transition-colors">
          ↑ Top
        </a>
      </div>

    </div>
  </div>
</footer>
