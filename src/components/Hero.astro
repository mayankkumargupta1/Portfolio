          <span class="w-2.5 h-2.5 bg-[#ffaa00]"></span>
          <span class="w-2.5 h-2.5 bg-[#00ff66]"></span>
          <span class="ml-2 font-bold tracking-widest uppercase">TERMINAL: SESSION_001.LOG</span>
        </div>
        <div class="text-zinc-400 font-mono text-[11px] hidden sm:block">
          ARCH_LINUX_x86_64 // PID: 1337
        </div>
      </div>

      <div class="text-xs sm:text-sm font-mono space-y-1 text-[#00ff66]">
        <p><span class="text-zinc-400">root@mayank:~$</span> initialize_protocol --target="matrix_portfolio" --mode=brutalist</p>
