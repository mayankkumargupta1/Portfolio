          <a 
            href="mailto:mayankcryptobyte@gmail.com" 
            class="matrix-btn bg-transparent text-zinc-300 hover:text-white px-4 py-2.5 border border-[#1a3826] hover:border-zinc-500"
          >
            Get in Touch
          </a>
        </div>

      </div>

      <!-- Right: Perfectly Aligned ASCII Portrait with Glitch Effect -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <div class="w-fit bg-[#050807] border border-[#1a3826] hover:border-[#00ff66] p-3 sm:p-4 rounded box-glow transition-colors">
          
          <div class="flex items-center justify-between border-b border-[#1a3826] pb-2 mb-3 text-[11px] text-zinc-400 font-mono">
            <span class="text-[#00ff66] font-bold">&gt; portrait.ascii</span>
            <span class="text-[10px] text-zinc-500">mayank@arch</span>
          </div>

          <!-- Fixed-width, centered, monospaced ASCII portrait with periodic 7s glitch -->
          <div class="flex justify-center items-center overflow-hidden">
            <pre 
              id="ascii-portrait-el" 
              class="ascii-art glitch-portrait text-[#00ff66] text-[7px] sm:text-[8px] md:text-[9px] select-none text-center"
            >{asciiPortrait}</pre>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  // Subtle character glitch synchronizer (every 7 seconds for ~220ms)
  const portraitEl = document.getElementById('ascii-portrait-el');
  if (portraitEl) {
    const originalText = portraitEl.textContent || '';
    const glitchChars = '01アイウエオカキクケコサシスセソ0123456789µλπ∑⚡∆§#%*';

    function triggerCharGlitch() {
      if (document.hidden || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      const chars = originalText.split('');
      const len = chars.length;
      const numGlitches = Math.floor(Math.random() * 8) + 6;
      const mutatedIndices: number[] = [];

      for (let i = 0; i < numGlitches; i++) {
        const idx = Math.floor(Math.random() * len);
        if (chars[idx] !== '\n' && chars[idx] !== ' ') {
          mutatedIndices.push(idx);
          chars[idx] = glitchChars[Math.floor(Math.random() * glitchChars.length)];
        }
      }

      portraitEl.textContent = chars.join('');

      setTimeout(() => {
        portraitEl.textContent = originalText;
      }, 220);
    }

    // Trigger glitch at exactly 7 second intervals (with initial offset sync)
    setInterval(triggerCharGlitch, 7000);
  }
</script>
