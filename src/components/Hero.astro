---

<section id="about" class="py-12 md:py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      
      <!-- Left: Bio & Details -->
      <div class="lg:col-span-7 space-y-6">
        
        <div class="space-y-2">
          <div class="flex items-center gap-2 text-xs font-mono text-[#00ff66]">
            <span class="inline-block w-2 h-2 bg-[#00ff66] rounded-full animate-ping"></span>
            <span>Kolkata, India // Available for Opportunities</span>
          </div>

          <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-white uppercase">
            Mayank Kumar <span class="text-[#00ff66] text-glow">Gupta</span>
          </h1>

          <p class="text-sm sm:text-base font-semibold text-[#39ff14]">
            Backend | AI/ML Engineer
          </p>
        </div>

        <p class="text-sm text-zinc-300 leading-relaxed">
          Focused on building scalable, high-performance web applications and robust backend architectures. 
          Experienced in developing full-stack products, responsive interfaces, and systems integrated with AI-powered services. 
          B.Tech in Computer Science at <span class="text-white font-medium">Lovely Professional University</span>.
        </p>

        <!-- Concise Stack Tags -->
        <div class="flex flex-wrap gap-2 text-xs font-mono">
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">Python</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">Django</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">FastAPI</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">LangGraph</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">React</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">Next.js</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">PostgreSQL</span>
          <span class="px-2.5 py-1 bg-[#0a110d] text-[#00ff66] border border-[#1a3826]">Docker</span>
        </div>

        <!-- Action CTAs -->
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-mono font-bold">
          <a 
            href={blogUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="matrix-btn bg-[#00ff66] text-[#050807] px-4 py-2.5 border border-[#00ff66] flex items-center gap-1.5"
          >
            <span>Read Blog</span>
            <span>↗</span>
          </a>

          <a 
            href="#projects" 
            class="matrix-btn bg-[#0a110d] text-[#00ff66] px-4 py-2.5 border border-[#1a3826] hover:border-[#00ff66]"
          >
            Projects
          </a>

          <a 
            href="mailto:mayankcryptobyte@gmail.com" 
            class="matrix-btn bg-transparent text-zinc-300 hover:text-white px-4 py-2.5 border border-[#1a3826] hover:border-zinc-500"
          >
            Get in Touch
          </a>
        </div>

      </div>

      <!-- Right: Authentic ASCII Portrait -->
      <div class="lg:col-span-5 flex flex-col items-center">
        <div class="w-full max-w-sm sm:max-w-md bg-[#050807] border border-[#1a3826] p-3 rounded box-glow">
          <div class="flex items-center justify-between border-b border-[#1a3826] pb-2 mb-2 text-[11px] text-zinc-400 font-mono">
            <span class="text-[#00ff66] font-bold">&gt; portrait.ascii</span>
            <span class="text-[10px]">mayank@arch</span>
          </div>

          <!-- Scaled monospace rendering of exact ASCII art -->
          <pre class="ascii-art text-[#00ff66] text-[7.5px] sm:text-[8.5px] md:text-[9.5px] leading-[1.05] overflow-x-auto select-none">{asciiPortrait}</pre>
        </div>
      </div>

    </div>

  </div>
</section>
