    <!-- Top System Boot Terminal Bar -->
    <div class="border-2 border-[#00ff66] bg-[#0a110d] p-3 sm:p-4 mb-8 sm:mb-12 brutal-shadow">
      <div class="flex items-center justify-between border-b border-[#1a3826] pb-2 mb-3 text-xs">
