---
// Accurate Projects section matching resume

interface Project {
  title: string;
  tagline: string;
  description: string;
  stack: string[];
  url: string;
  linkText: string;
}

const projects: Project[] = [
  {
    title: "LPU Live",
    tagline: "Campus Communication Platform",
    description: "Built to centralize and streamline internal communication inside Lovely Professional University, replacing fragmented third-party messaging apps and email threads with an integrated non-profit self-service platform for fellow university students.",
    stack: ["FastAPI", "WebSockets", "React", "PostgreSQL", "Docker"],
    url: "https://lpulive.lpu.in/",
    linkText: "lpulive.lpu.in"
  },
  {
    title: "Hamara Basket Bazaar",
    tagline: "E-commerce Grocery App",
    description: "An e-commerce grocery application built with React Native and Django on a PostgreSQL backend. Currently live on the Google Play Store with 1.8k+ downloads and active commercial operations.",
    stack: ["React Native", "Django", "PostgreSQL", "REST APIs"],
    url: "https://play.google.com/store/apps/details?id=com.getsetdeployed.com&hl=en",
    linkText: "Google Play Store"
  },
  {
    title: "Gradglobe.org",
    tagline: "Foreign University Application & Shortlisting",
    description: "An international university application and shortlisting platform built with FastAPI, Django, Next.js, and PostgreSQL. Hosts data for 1,500+ universities across 55k+ courses, functioning as a comprehensive ecosystem to manage applications and students for Lovely AVM corporations.",
    stack: ["FastAPI", "Django", "Next.js", "PostgreSQL"],
    url: "https://gradglobe.org/",
    linkText: "gradglobe.org"
  }
];
---

<section id="projects" class="py-12 border-t border-[#1a3826]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="mb-8">
      <div class="text-xs font-mono text-[#00ff66] uppercase font-semibold mb-1">
        // Featured Work
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        Projects
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {projects.map((project) => (
        <article class="border border-[#1a3826] hover:border-[#00ff66] bg-[#0a110d] p-5 sm:p-6 rounded flex flex-col justify-between transition-colors">
          
          <div class="space-y-3">
            <div>
              <span class="text-[10px] font-mono text-[#00ff66] font-semibold uppercase tracking-wider block mb-1">
                {project.tagline}
              </span>
              <h3 class="text-lg font-bold text-white">
                {project.title}
              </h3>
            </div>

            <p class="text-xs sm:text-sm text-zinc-300 leading-relaxed">
              {project.description}
            </p>
          </div>

          <div class="pt-6 space-y-4">
            <!-- Tech stack chips -->
            <div class="flex flex-wrap gap-1.5">
              {project.stack.map((tech) => (
                <span class="text-[10px] font-mono px-2 py-0.5 bg-[#050807] text-[#00ff66] border border-[#1a3826]">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Outbound link -->
            <div class="pt-2 border-t border-[#14261b]">
              <a 
                href={project.url} 
                target="_blank" 
                rel="noopener noreferrer"
                class="text-xs font-mono font-semibold text-[#00ff66] hover:underline inline-flex items-center gap-1 focus:outline-none"
              >
                <span>Visit {project.linkText}</span>
                <span>↗</span>
              </a>
            </div>
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
