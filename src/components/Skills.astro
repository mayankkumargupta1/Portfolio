---
// Accurate Skills & Education section matching resume

const skillGroups = [
  {
    category: "Languages & Runtimes",
    items: ["Python (3.6, 3.10, 3.14 / PEP 8)", "TypeScript / JavaScript", "Rust", "C", "Cython", "PyPy"]
  },
  {
    category: "AI & LangChain Ecosystem",
    items: ["LangGraph", "LangChain", "Deep Research Agents", "Agentic Workflows"]
  },
  {
    category: "Backend & APIs",
    items: ["Django", "FastAPI", "REST APIs", "GraphQL (strawberry.rocks)", "WebSockets"]
  },
  {
    category: "Databases & Graph",
    items: ["Neo4j & Memgraph (OpenCypher)", "PostgreSQL", "Redis"]
  },
  {
    category: "Frontend",
    items: ["React", "Next.js", "Tailwind CSS", "Astro"]
  },
  {
    category: "Systems & Infrastructure",
    items: ["Arch Linux", "Docker Deployments", "Git", "Bun"]
  }
];
---

<section id="skills" class="py-12 border-t border-[#1a3826]">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- Skills Matrix -->
      <div class="lg:col-span-8 space-y-6">
        <div>
          <div class="text-xs font-mono text-[#00ff66] uppercase font-semibold mb-1">
            // Technical Stack
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Skills & Tools
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {skillGroups.map((group) => (
            <div class="border border-[#1a3826] bg-[#0a110d] p-4 rounded">
              <h3 class="text-xs font-mono font-bold text-[#00ff66] uppercase tracking-wider mb-2.5">
                {group.category}
              </h3>
              <ul class="space-y-1 text-xs text-zinc-300">
                {group.items.map((item) => (
                  <li class="flex items-center gap-1.5">
                    <span class="text-[#00ff66] text-[10px] select-none">&gt;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Education & Certifications -->
      <div class="lg:col-span-4 space-y-6">
        <div>
          <div class="text-xs font-mono text-[#00ff66] uppercase font-semibold mb-1">
            // Credentials
          </div>
          <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
            Education
          </h2>
        </div>

        <div class="space-y-4">
          <!-- LPU Degree -->
          <div class="border border-[#1a3826] bg-[#0a110d] p-4 rounded space-y-1.5">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-[#00ff66] font-bold">B.Tech in Computer Science</span>
              <span class="text-white font-bold bg-[#14261b] px-2 py-0.5 rounded">CGPA 8.37</span>
            </div>
            <p class="text-xs font-semibold text-white">Lovely Professional University</p>
            <p class="text-[11px] font-mono text-zinc-400">Aug 2023 — Present • Jalandhar, Punjab</p>
          </div>

          <!-- Schooling -->
          <div class="border border-[#1a3826] bg-[#0a110d] p-4 rounded space-y-1.5">
            <div class="flex items-center justify-between text-xs font-mono">
              <span class="text-zinc-300">Intermediate (PCM)</span>
              <span class="text-zinc-400">74%</span>
            </div>
            <p class="text-xs text-zinc-300">Infocus India Public School</p>
            <p class="text-[11px] font-mono text-zinc-400">2021 — 2023</p>
          </div>

          <!-- Certifications list -->
          <div class="border border-[#1a3826] bg-[#0a110d] p-4 rounded">
            <h3 class="text-xs font-mono font-bold text-[#00ff66] uppercase tracking-wider mb-2">
              Certifications
            </h3>
            <ul class="space-y-2 text-xs text-zinc-300">
              <li>
                <div class="font-semibold text-white">Django Web Framework</div>
                <div class="text-[10px] text-zinc-400">Meta, Coursera</div>
              </li>
              <li>
                <div class="font-semibold text-white">Data Analysis with Python</div>
                <div class="text-[10px] text-zinc-400">IBM, Coursera</div>
              </li>
              <li>
                <div class="font-semibold text-white">Python (Basic)</div>
                <div class="text-[10px] text-zinc-400">HackerRank</div>
              </li>
            </ul>
          </div>
        </div>

      </div>

    </div>

  </div>
</section>
