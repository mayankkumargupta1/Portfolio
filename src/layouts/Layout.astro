---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mayank Kumar Gupta | Backend & AI/ML Engineer",
  description = "Backend & AI/ML Engineer specializing in Agentic AI, LangGraph, FastAPI, Django, React, and scalable backend architectures.",
} = Astro.props;

const siteUrl = "https://mayankkumargupta.com";
const blogUrl = "https://blogs.mayankkumargupta.com";
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Mayank Kumar Gupta" />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#050807" />
    <link rel="canonical" href={siteUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Mayank Kumar Gupta" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary" />
    <meta property="twitter:url" content={siteUrl} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap" 
      rel="stylesheet"
      media="print" 
      onload="this.media='all'" 
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&display=swap" />
    </noscript>

    <!-- Schema.org Person -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Mayank Kumar Gupta",
      "url": siteUrl,
      "email": "mailto:mayankcryptobyte@gmail.com",
      "jobTitle": "Backend & AI/ML Engineer",
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Lovely Professional University"
      },
      "sameAs": [
        "https://github.com/mayankkumargupta1",
        "https://linkedin.com/in/mayankkumargupta1",
        blogUrl
      ],
      "knowsAbout": [
        "Artificial Intelligence",
        "Machine Learning",
        "LangChain",
        "LangGraph",
        "FastAPI",
        "Django",
        "Python",
        "TypeScript",
        "React",
        "Docker"
      ]
    })} />
  </head>
  <body class="bg-[#050807] text-[#e2fce9] font-mono antialiased min-h-screen relative overflow-x-hidden selection:bg-[#00ff66] selection:text-[#050807]">
    <!-- Subtle CRT Scanlines -->
    <div class="crt-overlay" aria-hidden="true"></div>

    <slot />
  </body>
</html>
